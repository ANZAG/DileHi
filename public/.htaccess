# Diese Datei liegt auf dem Webspace und wird dort gelesen -- im
# FTP-Programm, im Dateimanager des Hosters, notfalls in einem Editor ohne
# Einstellungen. Solche Werkzeuge raten die Kodierung, und aus einem Umlaut
# werden dann zwei Zeichen Zeichensalat. Deshalb steht hier nichts ausser
# ASCII: Dem Apache ist es egal, dem Menschen davor nicht.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Adressen, die nach draussen gehen - Kalender-Abos, Einbindungen auf
  # fremden Seiten, die Sitemap -, laufen ueber diese Seite und werden von hier
  # an die Edge Functions weitergeleitet. Zieht die Datenbank um, aendert sich
  # nur das Ziel, nicht die Adresse im Handy oder auf der fremden Seite.
  #
  # __FUNCTIONS_URL__ setzt der Build ein (vite.config.ts). Die Pfade stehen
  # auch in src/lib/publicAddresses.ts; ein Test prueft, dass beide passen.
  #
  # 302 statt 301: Ein 301 merken sich Kalenderprogramme fuer immer, und dann
  # hilft beim naechsten Umzug auch diese Weiterleitung nicht mehr.
  RewriteRule ^kalender/veranstaltungen\.ics$ __FUNCTIONS_URL__/events-ical/veranstaltungen.ics [R=302,L,QSA]
  RewriteRule ^kalender/meine-termine\.ics$ __FUNCTIONS_URL__/events-personal-ical/meine-termine.ics [R=302,L,QSA]
  RewriteRule ^einbindung/(events|personas|gallery)(\.js|\.html)?$ __FUNCTIONS_URL__/embed/$1$2 [R=302,L,QSA,E=EINBINDUNG:1]
  RewriteRule ^sitemap\.xml$ __FUNCTIONS_URL__/sitemap [R=302,L]
  RewriteRule ^llms\.txt$ __FUNCTIONS_URL__/llms [R=302,L]

  # Bestehende Dateien und Verzeichnisse direkt ausliefern
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Alle anderen Anfragen an die SPA (index.html) weiterleiten
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Caching: index.html nie cachen, damit neue Deployments sofort greifen
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Wer die Einbindung als Daten abruft (fetch von einer fremden Seite), geht
  # durch diese Weiterleitung. Ohne die Freigabe hier bricht der Browser
  # schon an ihr ab, bevor er die Funktion erreicht.
  Header always set Access-Control-Allow-Origin "*" env=EINBINDUNG

  # Grundschutz fuer jede Antwort der Seite:
  # - nosniff: Der Browser nimmt den angegebenen Dateityp ernst und haelt ein
  #   hochgeladenes Bild nicht fuer ein Skript.
  # - SAMEORIGIN: Fremde Seiten koennen den Mitgliederbereich nicht unsichtbar
  #   einrahmen und Klicks darauf umlenken. Der Seitenbaukasten rahmt die
  #   Vorschau auf derselben Adresse ein, das bleibt erlaubt. Die Einbindungen
  #   fuer fremde Seiten kommen von den Edge Functions, nicht von hier.
  # - Referrer: Fremde Seiten erfahren beim Klick auf einen Link nur die
  #   Adresse der Seite, nicht den Pfad im Mitgliederbereich.
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
