# Kopfzeilen fuer Netlify und Cloudflare Pages -- die Entsprechung zum
# <IfModule mod_headers.c>-Teil der .htaccess.

# Wer die Einbindung als Daten abruft (fetch von einer fremden Seite), geht
# durch die Weiterleitung. Ohne die Freigabe hier bricht der Browser schon an
# ihr ab, bevor er die Funktion erreicht.
/einbindung/*
  Access-Control-Allow-Origin: *

# Grundschutz fuer jede Antwort, Begruendung in der .htaccess.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# HTML nie zwischenspeichern, damit ein neuer Stand sofort greift -- auch die
# fertigen Seiten unter _vorab/ und die 404.html (Begruendung in der .htaccess).
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/404.html
  Cache-Control: no-cache, no-store, must-revalidate
/_vorab/*
  Cache-Control: no-cache, no-store, must-revalidate

# Programmteile mit Pruefsumme im Namen: ein Jahr, ohne Nachfrage.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
